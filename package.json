{
  "name": "devboard",
  "private": true,
  "version": "1.0.0",
  "description": "DevBoard — веб-приложение для управления личными проектами программиста",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "api": "python -m uvicorn app.main:app --app-dir backend --reload --port 8000",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "tsc --noEmit && vite build --config vite.standalone.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
