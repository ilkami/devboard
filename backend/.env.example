# Скопируйте в .env и подставьте свои значения
DATABASE_URL=postgresql+psycopg://devboard:devboard@localhost:5432/devboard

# Обязательно замените на длинную случайную строку
SECRET_KEY=change-me-to-a-long-random-string

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# true — только при работе по HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Демо-пользователь и справочники при первом запуске
SEED_DEMO=true

# Отдавать токен сброса пароля в ответе API (учебный режим без почты)
EXPOSE_RESET_TOKEN=true
